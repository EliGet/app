        <html><head>
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <link rel="stylesheet" href="/style.css">
        <link rel="icon" type="image/svg+xml" href="/favicon.svg">
        <title>Sign Up - EliGet</title>
        </head><body>
        <div class="auth-page">
            <div class="auth-topbar">
