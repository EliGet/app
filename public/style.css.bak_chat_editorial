.pp-stat-label { font-size: 0.7rem; color: #a0aec0; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px; margin-top: 2px; }
.pp-action-btn { display: inline-block; padding: 12px 32px; border-radius: 12px; font-size: 0.95rem; font-weight: 700; text-decoration: none; border: none; cursor: pointer; font-family: inherit; transition: all 0.15s; }
.pp-action-btn.primary { background: linear-gradient(135deg, #3182ce, #2b6cb0); color: #fff; box-shadow: 0 6px 14px rgba(49,130,206,0.25); }
