/* ===== Auth verified badge v1 ===== */
.au-verified {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 14px;
    background: #f0fdf4;
    border: 1px solid #bbf7d0;
    color: #16a34a;
    border-radius: 999px;
    font-size: 0.82rem;
    font-weight: 700;
    margin-bottom: 20px;
    letter-spacing: 0.1px;
}
.au-verified svg { display: block; }

/* ===== Feed editorial v1 ===== */
.container {
    padding: 16px 16px 100px !important;
}

.feed-header {
    border-bottom: none !important;
    padding-bottom: 8px !important;
    margin-bottom: 12px !important;
}
.feed-title {
    font-size: 1.35rem !important;
    font-weight: 800 !important;
    letter-spacing: -0.6px !important;
    color: #0f172a !important;
}

/* Post card */
.post-card {
    background: #fff !important;
    border: 1px solid #e2e8f0 !important;
    border-radius: 14px !important;
    padding: 18px 18px 12px !important;
    margin-bottom: 12px !important;
    box-shadow: 0 1px 2px rgba(15,23,42,0.02) !important;
    transition: border-color 0.15s ease !important;
}
.post-card:hover {
    border-color: #cbd5e1 !important;
}

/* Header */
.post-header {
    margin-bottom: 12px !important;
    gap: 11px !important;
}
.post-avatar {
    width: 40px !important;
    height: 40px !important;
    font-size: 1.05rem !important;
    font-weight: 700 !important;
    box-shadow: 0 0 0 1px rgba(15,23,42,0.04) !important;
}
.post-avatar-link:hover .post-avatar {
    transform: none !important;
}

.post-user-info {
    flex: 1;
    min-width: 0;
}
.post-author-name {
    font-size: 0.94rem !important;
    font-weight: 700 !important;
    color: #0f172a !important;
    letter-spacing: -0.1px !important;
}
.post-author-link:hover .post-author-name {
    color: #0f172a !important;
    text-decoration: underline;
    text-underline-offset: 2px;
}

.post-meta-row {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-top: 2px;
    font-size: 0.75rem;
    color: #94a3b8;
    line-height: 1.2;
}
.post-meta-dot {
    color: #cbd5e1;
    font-weight: 700;
}
.post-edited {
    color: #94a3b8;
    font-style: italic;
}
.post-mood {
    width: 18px !important;
    height: 18px !important;
    margin-left: 6px !important;
}
.post-mood svg {
    width: 16px !important;
    height: 16px !important;
    fill: #64748b !important;
    opacity: 0.75 !important;
}

/* Body */
.post-content {
    font-size: 0.96rem !important;
    line-height: 1.6 !important;
    color: #1e293b !important;
    padding-left: 0 !important;
    margin-top: 0 !important;
    word-wrap: break-word;
    white-space: pre-wrap;
}

/* Image scene — full width */
.post-image-scene {
    margin-top: 14px !important;
    padding-left: 0 !important;
}
.post-image-scene svg {
    width: 100% !important;
    max-width: 100% !important;
    height: auto !important;
    aspect-ratio: 16/10 !important;
    border-radius: 12px !important;
    border: 1px solid #e2e8f0 !important;
    box-shadow: none !important;
    display: block !important;
}

/* Love row — subtle */
.post-love-row {
    margin-top: 12px !important;
    padding-top: 4px !important;
    display: flex;
    align-items: center;
}
.post-love-btn {
    gap: 6px !important;
    padding: 7px 10px 7px 8px !important;
    border-radius: 10px !important;
    color: #64748b !important;
    font-size: 0.83rem !important;
    font-weight: 600 !important;
    transition: background 0.15s ease, color 0.15s ease !important;
}
.post-love-btn svg {
    width: 17px !important;
    height: 17px !important;
}
.post-love-btn:hover {
    background: #fef2f2 !important;
    color: #dc2626 !important;
}
.post-love-btn.liked {
    color: #dc2626 !important;
}
.post-love-count {
    font-variant-numeric: tabular-nums;
    min-width: 8px;
}

/* Post menu (3-dot) */
.post-menu-btn {
    width: 34px !important;
    height: 34px !important;
    border-radius: 50% !important;
    color: #94a3b8 !important;
    transition: background 0.15s ease, color 0.15s ease !important;
}
.post-menu-btn:hover {
    background: #f1f5f9 !important;
    color: #0f172a !important;
}
.post-menu-btn svg {
    width: 18px !important;
    height: 18px !important;
    fill: currentColor !important;
}

/* Empty state */
.empty-state {
    background: #fff;
    border: 1px dashed #e2e8f0;
    border-radius: 14px;
    padding: 40px 20px !important;
    text-align: center;
}
.empty-state svg {
    width: 40px !important;
    height: 40px !important;
    fill: #cbd5e1 !important;
    margin-bottom: 12px;
}
.empty-state p {
    color: #64748b !important;
    font-size: 0.92rem !important;
    margin: 0 0 16px !important;
}
.empty-state a {
    display: inline-block;
    padding: 11px 20px;
    background: #0f172a;
    color: #fff !important;
    border-radius: 10px;
    text-decoration: none !important;
    font-weight: 600;
    font-size: 0.88rem;
    transition: background 0.15s ease;
}
.empty-state a:hover { background: #1e293b; }

/* ===== Profile editorial v1 ===== */

/* Page header (Your Profile / Profile) */
.container > header {
    border-bottom: none !important;
    padding-bottom: 4px !important;
    margin-bottom: 14px !important;
}
.container > header .profile-title {
    font-size: 1.35rem !important;
    font-weight: 800 !important;
    letter-spacing: -0.6px !important;
    color: #0f172a !important;
}

/* Profile card */
.pp-card {
    background: #fff !important;
    border: 1px solid #e2e8f0 !important;
    border-radius: 16px !important;
    padding: 28px 22px 22px !important;
    box-shadow: 0 1px 2px rgba(15,23,42,0.02) !important;
    margin-bottom: 22px !important;
    text-align: center !important;
    position: relative !important;
}

/* Avatar */
.pp-avatar-wrap {
    width: 92px !important;
    height: 92px !important;
    margin: 0 auto 16px !important;
}
.pp-avatar {
    width: 92px !important;
    height: 92px !important;
    font-size: 2.4rem !important;
    font-weight: 700 !important;
    background: #0f172a !important;
    box-shadow: 0 6px 18px rgba(15,23,42,0.10) !important;
    border: 3px solid #fff !important;
    color: #fff !important;
}

/* Name */
.pp-name-row {
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    gap: 8px !important;
    margin-bottom: 5px !important;
    flex-wrap: wrap !important;
}
.pp-name {
    font-size: 1.32rem !important;
    font-weight: 800 !important;
    color: #0f172a !important;
    letter-spacing: -0.5px !important;
    margin: 0 !important;
    line-height: 1.2 !important;
}
.pp-username {
    font-size: 0.85rem !important;
    color: #94a3b8 !important;
    font-weight: 500 !important;
    margin: 0 0 14px !important;
    letter-spacing: 0.1px !important;
}

/* Bio */
.pp-bio {
    font-size: 0.9rem !important;
    color: #475569 !important;
    line-height: 1.55 !important;
    max-width: 320px !important;
    margin: 0 auto 16px !important;
    padding: 0 6px !important;
}

/* Badges (both inline & grid) */
.pp-badge-inline,
.pp-badge {
    width: 26px !important;
    height: 26px !important;
    border-radius: 8px !important;
    background: #f1f5f9 !important;
    box-shadow: none !important;
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
}
.pp-badge-inline svg,
.pp-badge svg {
    width: 14px !important;
    height: 14px !important;
    fill: #475569 !important;
}
.pp-badges {
    gap: 8px !important;
    margin: 4px 0 14px !important;
}

/* Stats line (own) */
.pp-stats-line {
    color: #64748b !important;
    font-size: 0.86rem !important;
    margin: 18px 0 0 !important;
    padding-top: 16px !important;
    border-top: 1px solid #f1f5f9 !important;
    letter-spacing: 0.1px !important;
}
.pp-stats-line strong {
    color: #0f172a !important;
    font-weight: 800 !important;
    font-size: 0.94rem !important;
}
.pp-stats-line .pp-dot {
    color: #cbd5e1 !important;
    margin: 0 8px !important;
}

/* Stats grid (other user) */
.pp-stats {
    display: flex !important;
    justify-content: center !important;
    gap: 40px !important;
    padding: 16px 0 0 !important;
    border-top: 1px solid #f1f5f9 !important;
    border-bottom: none !important;
    margin-bottom: 16px !important;
}
.pp-stat-num {
    font-size: 1.15rem !important;
    font-weight: 800 !important;
    color: #0f172a !important;
    line-height: 1.15 !important;
}
.pp-stat-label {
    font-size: 0.7rem !important;
    color: #94a3b8 !important;
    font-weight: 600 !important;
    letter-spacing: 0.6px !important;
    text-transform: uppercase !important;
    margin-top: 3px !important;
}

/* Action buttons */
.pp-action-btn {
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    padding: 13px 28px !important;
    border-radius: 12px !important;
    font-size: 0.92rem !important;
    font-weight: 700 !important;
    border: none !important;
    cursor: pointer !important;
    font-family: inherit !important;
    text-decoration: none !important;
    transition: background 0.18s ease, transform 0.12s ease !important;
    min-width: 180px !important;
}
.pp-action-btn.primary {
    background: #0f172a !important;
    color: #fff !important;
    box-shadow: none !important;
}
.pp-action-btn.primary:hover {
    background: #1e293b !important;
}
.pp-action-btn.primary:active {
    transform: scale(0.99) !important;
}
.pp-action-btn.disabled {
    background: #f1f5f9 !important;
    color: #94a3b8 !important;
    cursor: not-allowed !important;
}

/* Section title */
.pp-section-title {
    font-size: 0.72rem !important;
    font-weight: 700 !important;
    color: #94a3b8 !important;
    text-transform: uppercase !important;
    letter-spacing: 1.2px !important;
    margin-bottom: 14px !important;
    padding-left: 2px !important;
}

/* Menu (3-dot) refined */
.pp-menu-btn {
    top: 14px !important;
    right: 14px !important;
    width: 34px !important;
    height: 34px !important;
    color: #94a3b8 !important;
}
.pp-menu-btn:hover {
    background: #f1f5f9 !important;
    color: #0f172a !important;
}
.pp-menu-dropdown {
    top: 50px !important;
    right: 14px !important;
    border: 1px solid #e2e8f0 !important;
    box-shadow: 0 8px 24px rgba(15,23,42,0.08) !important;
    border-radius: 12px !important;
    padding: 5px !important;
}
.pp-menu-dropdown a {
    padding: 10px 14px !important;
    font-size: 0.88rem !important;
    color: #334155 !important;
    border-radius: 8px !important;
    font-weight: 500 !important;
}
.pp-menu-dropdown a:hover {
    background: #f1f5f9 !important;
    color: #0f172a !important;
}

/* Empty state inside profile */
.container .empty-state {
    background: #fff !important;
    border: 1px dashed #e2e8f0 !important;
    border-radius: 14px !important;
    padding: 36px 20px !important;
    text-align: center !important;
}
.container .empty-state p {
    color: #64748b !important;
    font-size: 0.9rem !important;
    margin: 0 0 14px !important;
}
.container .empty-state a {
    display: inline-block !important;
    padding: 11px 20px !important;
    background: #0f172a !important;
    color: #fff !important;
    border-radius: 10px !important;
    text-decoration: none !important;
    font-weight: 600 !important;
    font-size: 0.86rem !important;
}

/* ===== Post form editorial v1 ===== */
.container > header {
    border-bottom: none !important;
    padding-bottom: 4px !important;
    margin-bottom: 16px !important;
}
.container > header .profile-title {
    font-size: 1.35rem !important;
    font-weight: 800 !important;
    letter-spacing: -0.6px !important;
    color: #0f172a !important;
}
.container > header .header-icon {
    color: #64748b !important;
}

/* Form card */
.form-card {
    background: #fff !important;
    border: 1px solid #e2e8f0 !important;
    border-radius: 16px !important;
    padding: 24px 22px 22px !important;
    box-shadow: 0 1px 2px rgba(15,23,42,0.02) !important;
    margin-bottom: 20px !important;
}

/* Form group */
.form-group {
    margin-bottom: 22px !important;
}
.form-group label {
    display: block !important;
    font-size: 0.78rem !important;
    font-weight: 700 !important;
    color: #475569 !important;
    text-transform: uppercase !important;
    letter-spacing: 0.8px !important;
    margin-bottom: 9px !important;
}

/* Textarea */
.form-group textarea {
    width: 100% !important;
    padding: 14px 16px !important;
    font-size: 0.96rem !important;
    line-height: 1.55 !important;
    background: #f8fafc !important;
    border: 1.5px solid #e2e8f0 !important;
    border-radius: 12px !important;
    color: #0f172a !important;
    box-sizing: border-box !important;
    outline: none !important;
    font-family: inherit !important;
    resize: vertical !important;
    min-height: 140px !important;
    transition: background 0.15s ease, border-color 0.15s ease, box-shadow 0.15s ease !important;
}
.form-group textarea::placeholder {
    color: #94a3b8 !important;
}
.form-group textarea:focus {
    background: #fff !important;
    border-color: #0f172a !important;
    box-shadow: 0 0 0 3px rgba(15,23,42,0.06) !important;
}

/* Attach SVG button */
.attach-svg-btn {
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    gap: 10px !important;
    padding: 14px 20px !important;
    background: #f8fafc !important;
    color: #0f172a !important;
    border: 1.5px solid #e2e8f0 !important;
    border-radius: 12px !important;
    text-decoration: none !important;
    font-size: 0.9rem !important;
    font-weight: 600 !important;
    transition: background 0.15s ease, border-color 0.15s ease !important;
    margin-top: 4px !important;
}
.attach-svg-btn:hover {
    background: #fff !important;
    border-color: #94a3b8 !important;
}
.attach-svg-btn svg {
    width: 18px !important;
    height: 18px !important;
    fill: #64748b !important;
}

/* Attached preview */
.attached-preview {
    display: flex !important;
    align-items: center !important;
    gap: 12px !important;
    padding: 12px 14px !important;
    background: #f8fafc !important;
    border: 1px solid #e2e8f0 !important;
    border-radius: 12px !important;
    margin-bottom: 10px !important;
}
.attached-preview-icon {
    width: 48px !important;
    height: 48px !important;
    border-radius: 10px !important;
    overflow: hidden !important;
    flex-shrink: 0 !important;
    border: 1px solid #e2e8f0 !important;
    background: #fff !important;
}
.attached-preview-icon svg {
    width: 100% !important;
    height: 100% !important;
}
.attached-preview-info {
    flex: 1 !important;
    display: flex !important;
    flex-direction: column !important;
    gap: 2px !important;
}
.attached-preview-label {
    font-size: 0.88rem !important;
    font-weight: 700 !important;
    color: #0f172a !important;
}
.attached-preview-remove {
    font-size: 0.78rem !important;
    color: #dc2626 !important;
    text-decoration: none !important;
    font-weight: 600 !important;
    transition: color 0.15s ease;
}
.attached-preview-remove:hover {
    color: #991b1b !important;
    text-decoration: underline !important;
}

/* Primary submit button */
.btn-full {
    width: 100% !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    gap: 10px !important;
    padding: 16px 22px !important;
    background: #0f172a !important;
    color: #fff !important;
    border: none !important;
    border-radius: 12px !important;
    font-size: 0.98rem !important;
    font-weight: 700 !important;
    cursor: pointer !important;
    font-family: inherit !important;
    transition: background 0.18s ease, transform 0.12s ease !important;
    margin-top: 6px !important;
    -webkit-tap-highlight-color: transparent !important;
}
.btn-full:hover {
    background: #1e293b !important;
}
.btn-full:active {
    transform: scale(0.99) !important;
}
.btn-full:disabled {
    background: #94a3b8 !important;
    cursor: not-allowed !important;
}

/* ===== Post image aspect fix v1 ===== */
.post-image-scene svg {
    aspect-ratio: 1 / 1 !important;
    max-width: 100% !important;
    width: 100% !important;
    height: auto !important;
}

/* ===== Post image compact v2 ===== */
.post-image-scene {
    margin-top: 12px !important;
    padding-left: 0 !important;
    display: flex !important;
    justify-content: center !important;
}
.post-image-scene svg {
    width: 100% !important;
    max-width: 220px !important;
    height: auto !important;
    aspect-ratio: 1 / 1 !important;
    border-radius: 14px !important;
    border: 1px solid #e2e8f0 !important;
    box-shadow: 0 1px 3px rgba(15,23,42,0.04) !important;
    display: block !important;
}
