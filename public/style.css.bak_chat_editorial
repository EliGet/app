/* ===== Chat list polish v2 ===== */

/* --- Compact row height + hover --- */
.chat-list { border-radius: 0 0 14px 14px; }
.chat-item {
    padding: 12px 14px;
    border-bottom: 1px solid #f7fafc;
}
